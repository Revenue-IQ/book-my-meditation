# One .env at repo root, serves both workspaces. Only VITE_* vars reach the browser.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/meditation

# Local development: no-login mode with the role switcher — no Clerk keys needed.
AUTH_MODE=local
API_PORT=3001

# Clerk mode (what cloud deployments run; only set these locally to test real login).
# AUTH_MODE=clerk
# CLERK_SECRET_KEY=sk_test_...           # Clerk dashboard → API keys
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_... # build-time: restart `npm run dev` after changing
# ADMIN_EMAIL=you@example.com            # first sign-in with this email becomes the admin
# APP_URL=http://localhost:5173          # invitation + sitting emails link here

# Emails (Phase 5, Resend). Without RESEND_API_KEY, emails are printed to the server log
# instead of sent — local dev stays keyless. Until a domain is verified with Resend, keep
# the default onboarding@resend.dev sender and set EMAIL_REDIRECT_TO to your own inbox
# (Resend test mode can only deliver there anyway). Once the domain is live: set EMAIL_FROM
# to the verified sender and remove EMAIL_REDIRECT_TO. No code changes either way.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Heartfulness Sittings <sittings@yourdomain.org>
# EMAIL_REDIRECT_TO=you@example.com
