    "drizzle-orm": "^0.45.0",
    "hono": "^4.12.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vitest": "^5.0.0"
  }
}
